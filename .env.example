# Backend configuration
LLM_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_PROVIDER=openai
AI_SYSTEM_PROMPT=You are an expert code reviewer who responds with JSON.
AI_MOCK_MODE=true
AI_TIMEOUT_SECONDS=30

